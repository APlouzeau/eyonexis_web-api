  "query": "\n            SELECT n.id_note AS \"id_note: uuid::Uuid\", n.title, n.subtitle, f.folder_name AS folder, n.created_at, n.updated_at\n            FROM notes n\n            JOIN folders f ON n.id_folder = f.id_folder\n            WHERE n.id_note = $1\n            ",
